@page
@model PensiuneaLotus.Pages.ReservationServices.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>ReservationService</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="ReservationService.ReservationID" class="control-label"></label>
                <select asp-for="ReservationService.ReservationID" class ="form-control" asp-items="ViewBag.ReservationID" aria-required="true"></select>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="ReservationService.ServiceID" class="control-label"></label>
                <select asp-for="ReservationService.ServiceID" class ="form-control" asp-items="ViewBag.ServiceID" aria-required="true"></select>
            </div>
            <div class="form-group">
                <label asp-for="ReservationService.Quantity" class="control-label"></label>
                <input asp-for="ReservationService.Quantity" class="form-control" />
                <span asp-validation-for="ReservationService.Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
