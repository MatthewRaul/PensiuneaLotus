@page
@model IndexModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Panou Control";
}

<div class="text-center py-5 mb-4 bg-light rounded-3 border shadow-sm">
    <h1 class="display-4 fw-bold text-primary">Pensiunea Lotus</h1>
    <p class="lead text-muted">Sistem de management hotelier simplificat.</p>
    <hr class="my-4" style="width: 50%; margin: auto;">

    @if (!SignInManager.IsSignedIn(User))
    {
        // === CAZ 1: VIZITATOR (Aratăm butoane de Login) ===
        <p class="mb-4">Pentru a accesa datele, te rugăm să te autentifici.</p>

        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a class="btn btn-primary btn-lg px-4 gap-3 fw-bold" asp-area="Identity" asp-page="/Account/Login">
                🔐 Autentificare
            </a>
            <a class="btn btn-outline-secondary btn-lg px-4 fw-bold" asp-area="Identity" asp-page="/Account/Register">
                📝 Înregistrare
            </a>
        </div>
    }
    else
    {
        // === CAZ 2: ADMIN LOGAT (Mesaj de bun venit) ===
        <p>Bine ai revenit, <strong>@User.Identity?.Name</strong></p>
    }
</div>

@if (SignInManager.IsSignedIn(User))
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card text-white bg-success shadow-sm hover-shadow border-0">
                <div class="card-body d-flex justify-content-between align-items-center px-4 py-4">
                    <div>
                        <h2 class="card-title fw-bold mb-0">Total Încasări</h2>
                        <p class="mb-0 text-white-50">Suma totală a plăților confirmate</p>
                    </div>
                    <div class="display-5 fw-bold">
                        @Model.TotalIncasari.ToString("N2") RON
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">

        <div class="col">
            <div class="card h-100 border-0 shadow-sm hover-shadow">
                <div class="card-body text-center">
                    <div class="display-6 text-primary mb-3">📅</div>
                    <h5 class="card-title fw-bold">Rezervări</h5>
                    <p class="card-text text-muted">Gestionează rezervările curente sau creează una nouă.</p>
                </div>
                <div class="card-footer bg-white border-0 text-center pb-3">
                    <a asp-page="/Reservations/Index" class="btn btn-outline-primary">Vezi Lista</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm hover-shadow">
                <div class="card-body text-center">
                    <div class="display-6 text-success mb-3">🛏️</div>
                    <h5 class="card-title fw-bold">Camere</h5>
                    <p class="card-text text-muted">Verifică disponibilitatea și statusul camerelor.</p>
                </div>
                <div class="card-footer bg-white border-0 text-center pb-3">
                    <a asp-page="/Rooms/Index" class="btn btn-outline-success">Status Camere</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm hover-shadow">
                <div class="card-body text-center">
                    <div class="display-6 text-info mb-3">👥</div>
                    <h5 class="card-title fw-bold">Oaspeți</h5>
                    <p class="card-text text-muted">Baza de date cu clienții pensiunii.</p>
                </div>
                <div class="card-footer bg-white border-0 text-center pb-3">
                    <a asp-page="/Guests/Index" class="btn btn-outline-info">Vezi Oaspeți</a>
                </div>
            </div>
        </div>

    </div>

    <style>
        .hover-shadow:hover {
            transform: translateY(-5px);
            transition: all 0.3s ease;
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
        }
    </style>
}