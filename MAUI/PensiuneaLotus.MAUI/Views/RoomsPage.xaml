<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PensiuneaLotus.MAUI.Views.RoomsPage"
             Title="Camere - Pensiunea Lotus">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Listă Camere Disponibile" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <CollectionView x:Name="RoomsList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="LightGray" CornerRadius="10" Margin="0,5" Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="20">
                                <Label Text="{Binding Number, StringFormat='Camera {0}'}" FontAttributes="Bold" FontSize="18"/>
                                <Label Text="{Binding PricePerNight, StringFormat='{0:F2} RON'}" VerticalOptions="Center"/>
                                <Label Text="{Binding Capacity, StringFormat='Capacitate: {0} persoane'}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Button Text="Rezervă Acum" 
                                    Clicked="OnBookClicked" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="Green" 
                                    TextColor="White"
                                    CornerRadius="10" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>