<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PensiuneaLotus.Client.Pages.PaymentPage"
             Title="Finalizare și Plată"
             BackgroundColor="#F2F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Total de Plată" FontSize="24" FontAttributes="Bold" TextColor="#1F2937" HorizontalOptions="Center"/>

            <Frame BackgroundColor="White" BorderColor="#E5E7EB" CornerRadius="12" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Cost Cazare" TextColor="#4F46E5" FontAttributes="Bold" FontSize="16"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label x:Name="LblRoomInfo" Text="Camera..." TextColor="#374151" FontSize="14"/>
                        <Label x:Name="LblRoomPrice" Text="0.00 RON" TextColor="#111827" FontAttributes="Bold" HorizontalOptions="End"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <VerticalStackLayout Spacing="10">
                <Label Text="Adaugă Servicii" TextColor="#1F2937" FontAttributes="Bold" FontSize="16"/>

                <CollectionView x:Name="ColServices" HeightRequest="250">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,5" Padding="10" BackgroundColor="White" BorderColor="#E5E7EB" CornerRadius="8">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding IsSelected}" 
                                              CheckedChanged="OnServiceCheckedChanged"
                                              Color="#4F46E5"/>

                                    <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" TextColor="#374151" Margin="10,0"/>

                                    <Label Grid.Column="2" Text="{Binding Price, StringFormat='{0} RON'}" VerticalOptions="Center" TextColor="#4F46E5" FontAttributes="Bold"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Metoda de Plată" TextColor="#1F2937" FontAttributes="Bold" FontSize="16"/>

                <Frame Padding="15" BorderColor="#D1D5DB" CornerRadius="8" BackgroundColor="White" HasShadow="False">
                    <Grid ColumnDefinitions="*, Auto">

                        <Picker x:Name="PickerPaymentMethod" 
                    Grid.Column="0"
                    Title="Alege metoda..."
                    TitleColor="Gray"
                    TextColor="Black"
                    BackgroundColor="Transparent"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Cash / Numerar</x:String>
                                    <x:String>Card Bancar</x:String>
                                    <x:String>Transfer Bancar</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <Label Grid.Column="1" 
                   Text="▼" 
                   TextColor="Gray" 
                   VerticalOptions="Center"
                   FontSize="12"
                   InputTransparent="True"/>
                    </Grid>
                </Frame>
            </VerticalStackLayout>

            <Frame BackgroundColor="#4F46E5" CornerRadius="15" Padding="20" Margin="0,20,0,0">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="TOTAL GENERAL:" TextColor="White" FontAttributes="Bold" FontSize="18"/>
                        <Label x:Name="LblGrandTotal" Text="0.00 RON" TextColor="White" FontAttributes="Bold" FontSize="22" Grid.Column="1"/>
                    </Grid>

                    <Button Text="Confirmă și Plătește" 
                            Clicked="OnConfirmPaymentClicked"
                            BackgroundColor="White" 
                            TextColor="#4F46E5" 
                            FontAttributes="Bold" 
                            CornerRadius="8"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>