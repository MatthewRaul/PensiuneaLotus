<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PensiuneaLotus.Client.Pages.CreateReservationPage"
             Title="Rezervare Nouă"
             BackgroundColor="#F2F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Crează o Rezervare" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="#1F2937" 
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <Frame BackgroundColor="White" BorderColor="#E5E7EB" CornerRadius="15" Padding="25" HasShadow="True">
                <VerticalStackLayout Spacing="20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Alege Camera" TextColor="#4F46E5" FontAttributes="Bold" FontSize="15"/>

                        <Frame Padding="15,5,15,5" BorderColor="#D1D5DB" CornerRadius="8" BackgroundColor="#F9FAFB" HasShadow="False">
                            <Grid ColumnDefinitions="*, Auto">
                                <Picker x:Name="PickerRoom" 
                                        Grid.Column="0"
                                        Title="Apasa pentru a selecta camera..."
                                        TitleColor="#6B7280"
                                        TextColor="#1F2937"
                                        FontAttributes="Bold"
                                        ItemDisplayBinding="{Binding Number, StringFormat='Camera {0}'}"
                                        HorizontalOptions="FillAndExpand"/>

                                <Label Grid.Column="1" 
                                       Text="▼" 
                                       TextColor="#6B7280" 
                                       VerticalOptions="Center"
                                       FontSize="12"
                                       InputTransparent="True"/>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>


                    <VerticalStackLayout Spacing="8">
                        <Label Text="Alege Oaspetele" TextColor="#4F46E5" FontAttributes="Bold" FontSize="15"/>

                        <Frame Padding="15,5,15,5" BorderColor="#D1D5DB" CornerRadius="8" BackgroundColor="#F9FAFB" HasShadow="False">
                            <Grid ColumnDefinitions="*, Auto">
                                <Picker x:Name="PickerGuest" 
                                        Grid.Column="0"
                                        Title="Cauta oaspete..." 
                                        TitleColor="#6B7280"
                                        TextColor="#1F2937"
                                        FontAttributes="Bold"
                                        ItemDisplayBinding="{Binding LastName}"
                                        HorizontalOptions="FillAndExpand"/>

                                <Label Grid.Column="1" 
                                       Text="▼" 
                                       TextColor="#6B7280" 
                                       VerticalOptions="Center"
                                       FontSize="12"
                                       InputTransparent="True"/>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,10"/>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="Check-In" TextColor="#4B5563" FontAttributes="Bold" FontSize="14"/>
                            <Frame Padding="10,5" BorderColor="#D1D5DB" CornerRadius="8" BackgroundColor="#F9FAFB" HasShadow="False">
                                <DatePicker x:Name="DateCheckIn" TextColor="#1F2937"/>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Check-Out" TextColor="#4B5563" FontAttributes="Bold" FontSize="14"/>
                            <Frame Padding="10,5" BorderColor="#D1D5DB" CornerRadius="8" BackgroundColor="#F9FAFB" HasShadow="False">
                                <DatePicker x:Name="DateCheckOut" TextColor="#1F2937"/>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="Salvează Rezervarea" 
                            Clicked="OnSaveReservationClicked"
                            BackgroundColor="#4F46E5" 
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="50"
                            Margin="0,25,0,0"
                            Shadow="{Shadow Radius=5, Opacity=0.3}"/>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>