<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PensiuneaLotus.Client.Pages.RoomsPage"
             Title="Lista Camere"
             BackgroundColor="#F2F4F8">
    <Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="15">

        <Label Grid.Row="0" 
               Text="Situație Camere" 
               FontSize="26" 
               FontAttributes="Bold" 
               TextColor="#1F2937" 
               HorizontalOptions="Center"/>

        <Button Grid.Row="1" 
                Text="Actualizează Lista" 
                Clicked="OnRefreshClicked"
                BackgroundColor="#4F46E5" 
                TextColor="White"
                CornerRadius="10"
                HeightRequest="45"
                FontAttributes="Bold"/>

        <CollectionView Grid.Row="2" x:Name="ColRooms">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,6" Padding="15" BackgroundColor="White" BorderColor="#E5E7EB" CornerRadius="12" HasShadow="True">
                        <Grid ColumnDefinitions="*, Auto">

                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Number, StringFormat='Camera {0}'}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="#4F46E5"/>
                                <Label Text="{Binding Capacity, StringFormat='Capacitate: {0} persoane'}" 
                                       TextColor="#4B5563" FontSize="14"/>

                                <Label Text="{Binding PricePerNight, StringFormat='Pret: {0} RON / noapte'}" 
                                       TextColor="#6B7280" FontSize="13"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="1" 
                                   FontSize="14" 
                                   FontAttributes="Bold"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsOccupied}" Value="True">
                                        <Setter Property="Text" Value="OCUPAT" />
                                        <Setter Property="TextColor" Value="#EF4444" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsOccupied}" Value="False">
                                        <Setter Property="Text" Value="LIBER" />
                                        <Setter Property="TextColor" Value="#10B981" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="Lista este goală. Apasă butonul pentru încărcare." 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"
                       TextColor="Gray"/>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>